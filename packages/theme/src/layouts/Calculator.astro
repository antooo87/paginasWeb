---
import Base from './Base.astro';
import PageHead from '../components/PageHead.astro';
import Updated from '../components/Updated.astro';
import AdSlot from '../components/AdSlot.astro';
import Aside from '../components/Aside.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '@site-config';
import type { IconName } from '../site.ts';

interface Props {
  title: string;
  description: string;
  updated: string;
  icon?: IconName;
  sources?: { href: string; label: string }[];
  faq?: { q: string; a: string }[];
  category?: string;
}
const { title, description, updated, sources, faq = [], category = 'UtilitiesApplication' } = Astro.props;
const icon = Astro.props.icon ?? SITE.tools.find((t) => t.href === Astro.url.pathname)?.icon ?? 'calculator';
const crumbs = [{ href: '/calculadoras/', label: 'Calculadoras' }, { href: Astro.url.pathname, label: title }];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    url: new URL(Astro.url.pathname, SITE.url).href,
    applicationCategory: category,
    operatingSystem: 'Any',
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
];
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={title} description={description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <PageHead title={title} lead={description} tag="Calculadora gratuita" icon={icon} breadcrumbs={crumbs}>
    <Updated date={updated} sources={sources} />
  </PageHead>
  <div class="container with-aside">
    <article>
      <slot name="tool" />
      <p class="notice">
        <Icon name="shield" size={20} />
        <span>
          Resultado orientativo. No constituye asesoramiento {SITE.adviceTopic}; confirma tu caso con la
          fuente oficial o con un profesional.
        </span>
      </p>
      <AdSlot slot={SITE.adSlots.calc} />
      <div class="prose">
        <slot />
      </div>
      {faq.length > 0 && (
        <section class="faq">
          <h2>Preguntas frecuentes</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}
    </article>
    <Aside />
  </div>
</Base>
