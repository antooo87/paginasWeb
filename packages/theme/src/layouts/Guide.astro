---
import Base from './Base.astro';
import Updated from '../components/Updated.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '@site-config';

interface Props {
  title: string;
  description: string;
  updated: string;
  sources?: { href: string; label: string }[];
  related?: { href: string; label: string }[];
}
const { title, description, updated, sources, related = [] } = Astro.props;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    dateModified: updated,
    inLanguage: 'es',
    author: { '@type': 'Organization', name: SITE.name, url: new URL('/sobre-nosotros/', SITE.url).href },
    mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).href,
  },
];
---
<Base
  title={title}
  description={description}
  breadcrumbs={[{ href: '/guias/', label: 'Guías' }, { href: Astro.url.pathname, label: title }]}
  jsonLd={jsonLd}
>
  <article>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <Updated date={updated} sources={sources} />
    <slot name="intro" />
    <AdSlot slot={SITE.adSlots.article} />
    <slot />
    {related.length > 0 && (
      <section>
        <h2>Te puede servir</h2>
        <ul>{related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
      </section>
    )}
  </article>
</Base>
