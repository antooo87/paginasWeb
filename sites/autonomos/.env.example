# Copia este archivo a .env y rellénalo. .env NUNCA se sube al repositorio.
# En producción, define estas mismas variables en el panel del hosting
# (Cloudflare Pages: Settings > Variables and Secrets).
#
# Todo lo que empieza por PUBLIC_ acaba en el HTML público: úsalo solo para
# datos que pueden verse. Las claves de API o tokens van SIN el prefijo PUBLIC_.

PUBLIC_SITE_NAME=Autónomo Claro
PUBLIC_SITE_URL=https://tudominio.com

# ID de editor de AdSense (ca-pub- + 16 dígitos). El mismo en todos los sitios.
PUBLIC_ADSENSE_CLIENT=
# true solo en el entorno Production del hosting; false en Preview y en local.
PUBLIC_ADS_ENABLED=false
# IDs de bloques manuales (AdSense > Anuncios > Por bloque de anuncios). Opcionales.
PUBLIC_AD_SLOT_CALC=
PUBLIC_AD_SLOT_ARTICLE=

# Datos del titular para el Aviso legal y la Privacidad (obligatorios por la LSSI).
PUBLIC_OWNER_NAME=
PUBLIC_OWNER_NIF=
PUBLIC_OWNER_ADDRESS=
PUBLIC_CONTACT_EMAIL=
