---
import Base from '@paginasweb/theme/layouts/Base.astro';
import { GUIAS } from '../../data/content';
---
<Base
  title="Guías para autónomos"
  description="Guías prácticas para autónomos en España: alta, calendario fiscal, gastos deducibles y más."
  breadcrumbs={[{ href: '/guias/', label: 'Guías' }]}
>
  <h1>Guías para autónomos</h1>
  <p class="lead">Explicaciones paso a paso con enlaces a la normativa oficial.</p>
  <ul class="cards">
    {GUIAS.map((g) => <li><a class="card" href={g.href}><strong>{g.label}</strong><span>{g.desc}</span></a></li>)}
  </ul>
</Base>
