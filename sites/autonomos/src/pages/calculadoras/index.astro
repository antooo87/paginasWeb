---
import Base from '@paginasweb/theme/layouts/Base.astro';
import { CALCULADORAS } from '../../data/content';
---
<Base
  title="Calculadoras para autónomos"
  description="Todas las calculadoras fiscales para autónomos: cuota de autónomos, IVA, factura con retención y modelo 130."
  breadcrumbs={[{ href: '/calculadoras/', label: 'Calculadoras' }]}
>
  <h1>Calculadoras para autónomos</h1>
  <p class="lead">Herramientas gratuitas, sin registro y sin guardar tus datos: todo se calcula en tu navegador.</p>
  <ul class="cards">
    {CALCULADORAS.map((c) => <li><a class="card" href={c.href}><strong>{c.label}</strong><span>{c.desc}</span></a></li>)}
  </ul>
</Base>
